# Credenciales solo en .env local (protegido por .gitignore). No exponer al navegador ni registrar en logs.
# Groq (preferido para el reto). API compatible con Chat Completions.
GROQ_API_KEY=
# Alternativa, si se desea usar Anthropic.
ANTHROPIC_API_KEY=
# Modelo Groq compatible con llamadas de herramientas; sobrescribible para Anthropic.
LLM_MODEL=openai/gpt-oss-120b
PORT=8794
AGENTE_MAX_ITERACIONES=25
AGENTE_MAX_TOKENS_SESION=200000
AGENTE_MAX_TOKENS_RESPUESTA=4000
