# Variables del backend. Copie a .env y complete los valores; .env está en .gitignore.
# La clave del modelo vive SOLO aquí: nunca en el repositorio, el front ni los logs.

# Clave del proveedor LLM (Anthropic). Sin ella el servidor arranca, sirve el front y
# responde /api/health, pero /api/chat devuelve 503 explicando que falta la clave.
ANTHROPIC_API_KEY=

# Modelo a usar. Por defecto claude-sonnet-5 (buen balance costo/calidad para este flujo).
LLM_MODEL=claude-sonnet-5

# Puerto del backend (sirve API y front en el mismo origen).
PORT=8787

# Topes de costo (PRD §8). Protegen la clave de un uso ilimitado.
AGENTE_MAX_ITERACIONES=25
AGENTE_MAX_TOKENS_SESION=200000
AGENTE_MAX_TOKENS_RESPUESTA=4000
